# AI Job Post — environment template
# Copy to repo-root `.env` for local API/worker. Frontend uses `frontend/.env.local`.
# Production: put secrets in Google Secret Manager; non-secrets on Cloud Run env.

# --- shared ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# Supabase (Auth + Postgres + RLS + pgvector). Resume files use GCS in staging/production.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
SUPABASE_JWT_AUDIENCE=authenticated

# Google Cloud (required in staging/production — Vertex ADC, no GEMINI_API_KEY)
GOOGLE_CLOUD_PROJECT=imagi-ai-gpami
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_MODEL=gemini-2.0-flash-001
# Local/dev only:
# GEMINI_API_KEY=

GCS_BUCKET=
CLOUD_TASKS_QUEUE=aether-hire-tasks
DOCUMENT_AI_PROCESSOR_ID=

# Worker bridge
WORKER_URL=http://localhost:8081
BACKEND_URL=http://localhost:8000
WORKER_SHARED_SECRET=dev-worker-secret

# API CORS (comma-separated). Production = Cloud Run aether-web origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional sourcing integrations
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AetherHire/1.0

# Local resume fallback directory (when ENVIRONMENT=local)
RESUME_LOCAL_DIR=

# --- frontend (frontend/.env.local) ---
# NEXT_PUBLIC_ENVIRONMENT=local
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
