{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../frontend/*"],
      "vitest": ["../../frontend/node_modules/vitest"],
      "vitest/*": ["../../frontend/node_modules/vitest/*"]
    }
  },
  "include": ["./**/*.ts"]
}
